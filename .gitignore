# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything except the annotated template, which documents every
# variable and must ship with the repo.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# foundry
contracts/out/
contracts/cache/
# Broadcast logs record real deployment receipts. Kept out of the repo because
# they interleave mainnet runs with local fork rehearsals; the authoritative
# record is contracts/deployments/*.json.
contracts/broadcast/

# Vendored Solidity dependencies (OpenZeppelin, Chainlink, forge-std) are
# committed deliberately: they were installed by tarball rather than as git
# submodules, so the repo would not build for a fresh clone without them.
!contracts/lib/

# Commitment secrets. Publishing these would let anyone compute a round's
# outcome before it is revealed, which destroys the entire commit-reveal
# guarantee. Never commit, never bundle, never log.
keeper-secrets.json
keeper-secrets*.json

# Local agent/skill tooling — scaffolding, not app source.
.agents/
/agent/
.claude/skills/
data/skills/
skills-lock.json

# Local pitch deck (not part of the app build).
/public/deck.html

# One-off exploratory foundry scripts kept local. Legit deploy/config scripts in
# contracts/script/ are committed and unaffected (git ignores only untracked files).
/contracts/script/AddApeCoin.s.sol
