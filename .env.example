# =============================================================================
# ROBACHA — environment template
# =============================================================================
#
# Copy to `.env.local` and fill in. Nothing here has a working default beyond
# the public network values, and no contract address is assumed: an unset
# address makes the corresponding feature report itself unavailable rather than
# guessing. `/api/health` reports exactly which of these is missing.
#
# NEVER commit a filled-in copy of this file.
# NEVER put a private key, mnemonic or API secret in any NEXT_PUBLIC_ variable —
# those are compiled into the browser bundle and are public by definition.
# Deployment signing uses an encrypted Foundry keystore (see DEPLOYMENT.md); no
# private key is ever read from the environment or from source.
# =============================================================================


# -----------------------------------------------------------------------------
# Client-safe (compiled into the browser bundle — public by definition)
# -----------------------------------------------------------------------------

# Robinhood Chain mainnet. Verified against the node: eth_chainId -> 0x1237.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
NEXT_PUBLIC_ROBINHOOD_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_ROBINHOOD_CHAIN_NATIVE_SYMBOL=ETH

# Public endpoint. Fine for the browser; the server uses ROBINHOOD_RPC_URL.
NEXT_PUBLIC_ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_CHAIN_WS_URL=
NEXT_PUBLIC_ROBINHOOD_CHAIN_EXPLORER_URL=https://robinhoodchain.blockscout.com

# WalletConnect project id. Injected wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed contract addresses. Leave blank until deployment has been verified.
# Every one of these is read back for bytecode by /api/health; an address with
# no code is reported as missing, not as deployed.
NEXT_PUBLIC_ROBACHA_GACHA_ADDRESS=
NEXT_PUBLIC_ROBACHA_POOL_REGISTRY_ADDRESS=
NEXT_PUBLIC_ROBACHA_REWARD_VAULT_ADDRESS=
NEXT_PUBLIC_ROBACHA_FEE_ROUTER_ADDRESS=
NEXT_PUBLIC_ROBACHA_RANDOMNESS_RECEIVER_ADDRESS=
NEXT_PUBLIC_ROBACHA_RANDOMNESS_SENDER_ADDRESS=

# Which pool the app shows. The registry issues pool 1 first.
NEXT_PUBLIC_ROBACHA_POOL_ID=1

# Public paid spins. Both this and PUBLIC_PAID_SPINS_ENABLED below must be
# "true" before the spin button is enabled — and the contract's own pause and
# readiness checks still apply on top. Default is off.
NEXT_PUBLIC_PUBLIC_PAID_SPINS_ENABLED=false


# -----------------------------------------------------------------------------
# Server-only (never exposed to the browser; see lib/env/server.ts)
# -----------------------------------------------------------------------------

# Privileged addresses. These are addresses, not signers — an address here
# grants nothing by itself.
ROBACHA_DEPLOYER_ADDRESS=
ROBACHA_ADMIN_ADDRESS=0x19BF0B60852Afa668b261D3020A1A4321362e68D
ROBACHA_TREASURY_ADDRESS=0x19BF0B60852Afa668b261D3020A1A4321362e68D
ROBACHA_OPERATIONS_TREASURY=
ROBACHA_REWARD_RESERVE_TREASURY=
# Receives the randomness surcharge, which funds real CCIP and VRF costs.
# This is a cost account, not a revenue account.
ROBACHA_RANDOMNESS_TREASURY=

# Authenticated production RPC. The public endpoint is a health-check fallback
# only and is never used as the primary server endpoint.
ROBINHOOD_RPC_URL=
ROBINHOOD_WS_URL=
# Archive-capable endpoint. Required for historical event indexing; without it
# /api/activity covers only the recent window a standard node retains.
ROBINHOOD_ARCHIVE_RPC_URL=

ETHEREUM_RPC_URL=
ETHEREUM_WS_URL=

# --- Chainlink ---------------------------------------------------------------
# The router, coordinator, selector and key-hash values below are the official
# ones recorded in contracts/config/chainlink.json, with the endpoints they were
# read from. Do not substitute a value you have not verified there.
#
# The subscription id has no official default. Create and fund one at
# https://vrf.chain.link, then add the deployed Ethereum coordinator as a
# consumer. Deployment refuses to run without it.
CHAINLINK_VRF_SUBSCRIPTION_ID=
CHAINLINK_VRF_COORDINATOR=0xD7f86b4b8Cae7D942340FF628F82735b7a20893a
CHAINLINK_VRF_KEY_HASH=0x8077df514608a09f83e4e8d300645594e5d7234665448ba83f51a50f842bd3d9
CHAINLINK_VRF_CALLBACK_GAS_LIMIT=300000
CHAINLINK_VRF_CONFIRMATIONS=3
CHAINLINK_CCIP_ROUTER_ROBINHOOD=0x06fC836cf9839B1cd891C440A0a45242DA6Ae1c9
CHAINLINK_CCIP_ROUTER_ETHEREUM=0x80226fc0Ee2b096224EeAc085Bb9a8cba1146f7D
CHAINLINK_CCIP_ETHEREUM_SELECTOR=5009297550715157269
CHAINLINK_CCIP_ROBINHOOD_SELECTOR=6180753054346818345

# --- Backend -----------------------------------------------------------------
DATABASE_URL=
# Blocks behind head before a log is treated as final.
INDEXER_CONFIRMATION_DEPTH=12
# How far behind head the indexer may fall before data is withheld rather than
# served stale.
INDEXER_MAX_LAG_BLOCKS=200
PRICE_INDEXER_URL=

# --- Responsible launch ------------------------------------------------------
# The server-side half of the paid-spins switch. Must be "true", together with
# the NEXT_PUBLIC_ flag above, before any paid spin is possible. This is one
# control among several and never the only one — the gacha contract's own pause
# is independent of it.
PUBLIC_PAID_SPINS_ENABLED=false

# ISO 3166-1 alpha-2 codes where paid spins are not offered. Comma-separated.
ROBACHA_RESTRICTED_JURISDICTIONS=

# --- Deployment-time only (used by the Foundry scripts, not the app) ----------
ROBACHA_FEE_ROUTER=
ROBACHA_REWARD_VAULT=
ROBACHA_POOL_REGISTRY=
ROBACHA_GACHA=
ROBACHA_RANDOMNESS_SENDER=
ROBACHA_RANDOMNESS_RECEIVER=
ROBACHA_SPONSOR_REGISTRY=
ROBACHA_ETHEREUM_COORDINATOR=
ROBACHA_RETURN_GAS_LIMIT=500000

# Blockscout verification. Robinhood Chain Blockscout accepts any non-empty key.
BLOCKSCOUT_API_KEY=
ETHERSCAN_API_KEY=

# NOTE: there is deliberately no PRIVATE_KEY or MNEMONIC variable here.
# Deployment signs with `forge script --account <keystore-name>`, which prompts
# for the keystore password in your own terminal. See DEPLOYMENT.md.
